MENU_PROPERTY_TYPES = {
    "type": "s",
    "label": "s",
    "enabled": "b",
    "visible": "b",
    "toggle-type": "s",
    "toggle-state": "i",
    "children-display": "s",
}


def interface_info(xml):
    return Gio.DBusNodeInfo.new_for_xml(xml).interfaces[0]


def to_variants(props):
    return {key: GLib.Variant(MENU_PROPERTY_TYPES[key], value) for key, value in props.items()}


class DBusMenu:
    """Flat com.canonical.dbusmenu menu: labels, radio items and separators."""

    PATH = "/MenuBar"
    INTERFACE = "com.canonical.dbusmenu"

    def __init__(self, connection):
        self.connection = connection
        self.items = {}  # id -> [properties, callback]
        self.revision = 1
        connection.register_object(self.PATH, interface_info(MENU_XML), self.on_call, self.on_get, None)

    def add(self, props, callback=None):
        item_id = len(self.items) + 1
        self.items[item_id] = [dict(props), callback]
        return item_id

    def update(self, item_id, **props):
        current = self.items[item_id][0]
        changed = {key: value for key, value in props.items() if current.get(key) != value}
        if changed:
            current.update(changed)
            self.connection.emit_signal(
                None,
                self.PATH,
                self.INTERFACE,
                "ItemsPropertiesUpdated",
                GLib.Variant("(a(ia{sv})a(ias))", ([(item_id, to_variants(changed))], [])),
            )

    def node(self, item_id):
        return GLib.Variant("(ia{sv}av)", (item_id, to_variants(self.items[item_id][0]), []))

    def layout(self, parent):
        if parent in self.items:
            return (parent, to_variants(self.items[parent][0]), [])
        children = [self.node(item_id) for item_id in self.items]
        return (0, to_variants({"children-display": "submenu"}), children)

    def activate(self, item_id, event):
        callback = self.items.get(item_id, [None, None])[1]
        if event == "clicked" and callback:
            GLib.idle_add(lambda: (callback(), GLib.SOURCE_REMOVE)[1])

    def on_get(self, _conn, _sender, _path, _iface, name):
        values = {
            "Version": GLib.Variant("u", 3),
            "TextDirection": GLib.Variant("s", "ltr"),
            "Status": GLib.Variant("s", "normal"),
            "IconThemePath": GLib.Variant("as", []),
        }
        return values.get(name)

    def on_call(self, _conn, _sender, _path, _iface, method, params, invocation):
        args = params.unpack()
        if method == "GetLayout":
            invocation.return_value(GLib.Variant("(u(ia{sv}av))", (self.revision, self.layout(args[0]))))
        elif method == "GetGroupProperties":
            found = [(i, to_variants(self.items[i][0])) for i in args[0] if i in self.items]
            invocation.return_value(GLib.Variant("(a(ia{sv}))", (found,)))
        elif method == "GetProperty":
            props = self.items.get(args[0], [{}])[0]
            if args[1] not in props:
                invocation.return_dbus_error(self.INTERFACE + ".Error", "unknown property")
                return
            invocation.return_value(GLib.Variant("(v)", (to_variants({args[1]: props[args[1]]})[args[1]],)))
        elif method == "Event":
            self.activate(args[0], args[1])
            invocation.return_value(None)
        elif method == "EventGroup":
            for item_id, event, _data, _time in args[0]:
                self.activate(item_id, event)
            invocation.return_value(GLib.Variant("(ai)", ([],)))
        elif method == "AboutToShow":
            invocation.return_value(GLib.Variant("(b)", (False,)))
        elif method == "AboutToShowGroup":
            invocation.return_value(GLib.Variant("(aiai)", ([], [])))


class StatusNotifierItem:
    """Tray icon: left click calls on_activate, right click shows the menu."""

    PATH = "/StatusNotifierItem"
    INTERFACE = "org.kde.StatusNotifierItem"
    WATCHER = "org.kde.StatusNotifierWatcher"

    def __init__(self, title, on_activate):
        self.title = title
        self.tooltip = ""
        self.on_activate = on_activate
        self.registered = False
        self.connection = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.connection.register_object(self.PATH, interface_info(SNI_XML), self.on_call, self.on_get, None)
        self.menu = DBusMenu(self.connection)
        self.bus_name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"
        Gio.bus_own_name_on_connection(
            self.connection, self.bus_name, Gio.BusNameOwnerFlags.NONE, self.on_name_acquired, None
        )

    def on_name_acquired(self, connection, _name):
        # Registering again whenever the watcher appears survives panel restarts.
        Gio.bus_watch_name_on_connection(
            connection, self.WATCHER, Gio.BusNameWatcherFlags.NONE, self.on_watcher_appeared, self.on_watcher_vanished
        )

    def on_watcher_appeared(self, connection, _name, _owner):
        connection.call(
            self.WATCHER,
            "/StatusNotifierWatcher",
            self.WATCHER,
            "RegisterStatusNotifierItem",
            GLib.Variant("(s)", (self.bus_name,)),
            None,
            Gio.DBusCallFlags.NONE,
            -1,
            None,
            self.on_register_reply,
        )

    def on_register_reply(self, connection, result):
        try:
            connection.call_finish(result)
            self.registered = True
        except GLib.Error:
            self.registered = False

    def on_watcher_vanished(self, _connection, _name):
        self.registered = False

    def set_title(self, text):
        if text != self.title:
            self.title = text
            self.connection.emit_signal(None, self.PATH, self.INTERFACE, "NewTitle", None)

    def set_tooltip(self, text):
        if text != self.tooltip:
            self.tooltip = text
            self.connection.emit_signal(None, self.PATH, self.INTERFACE, "NewToolTip", None)

    def on_get(self, _conn, _sender, _path, _iface, name):
        values = {
            "Category": GLib.Variant("s", "Hardware"),
            "Id": GLib.Variant("s", "turboctl"),
            "Title": GLib.Variant("s", self.title),
            "Status": GLib.Variant("s", "Active"),
            "WindowId": GLib.Variant("i", 0),
            "IconName": GLib.Variant("s", "turboctl"),
            "IconThemePath": GLib.Variant("s", ""),
            "IconPixmap": GLib.Variant("a(iiay)", []),
            "OverlayIconName": GLib.Variant("s", ""),
            "AttentionIconName": GLib.Variant("s", ""),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", ("turboctl", [], self.title, self.tooltip)),
            "ItemIsMenu": GLib.Variant("b", False),
            "Menu": GLib.Variant("o", DBusMenu.PATH),
        }
        return values.get(name)

    def on_call(self, _conn, _sender, _path, _iface, method, _params, invocation):
        if method in ("Activate", "SecondaryActivate"):
            GLib.idle_add(lambda: (self.on_activate(), GLib.SOURCE_REMOVE)[1])
        invocation.return_value(None)


class Tray:
    def __init__(self, panel):
        self.sni = StatusNotifierItem(_("Turbo Boost"), panel.present_window)
        menu = self.menu = self.sni.menu
        self.reading = None
        self.reading_item = menu.add({"label": _("Connecting…"), "enabled": False})
        menu.add({"type": "separator"})
        self.open_item = menu.add({"label": _("Open Turbo Boost")}, panel.present_window)
        menu.add({"type": "separator"})
        self.profile_items = {
            name: menu.add({"label": _(label), "toggle-type": "radio", "toggle-state": 0}, self.chooser(panel, name))
            for name, label in PROFILE_LABELS.items()
        }
        menu.add({"type": "separator"})
        self.quit_item = menu.add({"label": _("Quit")}, panel.quit)

    @staticmethod
    def chooser(panel, name):
        return lambda: panel.choose_profile(name)

    @property
    def available(self):
        return self.sni.registered

    def retranslate(self):
        self.sni.set_title(_("Turbo Boost"))
        if self.reading is None:
            self.menu.update(self.reading_item, label=_("Connecting…"))
        self.menu.update(self.open_item, label=_("Open Turbo Boost"))
        for name, item in self.profile_items.items():
            self.menu.update(item, label=_(PROFILE_LABELS[name]))
        self.menu.update(self.quit_item, label=_("Quit"))

    def update(self, state):
        self.reading = f"{state['temp']} °C · {watts(state['watts'])} · {ghz(max(state['freqs']))}"
        self.menu.update(self.reading_item, label=self.reading)
        self.sni.set_tooltip(self.reading)
        for name, item in self.profile_items.items():
            props = {"toggle-state": int(state["profile"] == name), "enabled": name in state["profiles"]}
            self.menu.update(item, **props)


# ---------------------------------------------------------------- window


class Panel(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.app = app
        self.set_icon_name("turboctl")
        self.set_default_size(520, -1)
        self.set_border_width(16)
        self.connect("delete-event", self.on_delete)
        self.loading = False
        self.dirty = False
        self.uv_dirty = False
        self.state = None
        self.controls_built = False
        self.ratio_scales = []
        self.scales = {}
        self.tau_steps = []
        self.tau_previous = None
        self.uv_scale = None
        # Functions that set a text in the current language, run again when it changes.
        self.texts = []
        self.translated(lambda: self.set_title(_("Turbo Boost")))

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.add(self.box)
        self.cpu_label = Gtk.Label(xalign=0, wrap=True)
        self.box.add(self.cpu_label)
        self.build_readings()
        self.box.add(Gtk.Separator())
        self.box.pack_end(self.build_language_row(), False, False, 0)
        self.tray = Tray(self)

        self.helper = subprocess.Popen(
            HELPER, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, bufsize=1
        )
        threading.Thread(target=self.read_helper, daemon=True).start()

        # Set (and removed) by the copy of this window that restarted after an update.
        self.updated = os.environ.pop("TURBOCTL_UPDATED", None) is not None
        self.program = os.path.realpath(__file__)
        self.program_mtime = self.seen_mtime = os.stat(self.program).st_mtime_ns
        GLib.timeout_add_seconds(UPDATE_CHECK_SECONDS, self.check_update)

    def translated(self, set_text):
        self.texts.append(set_text)
        set_text()

    def caption(self, text, **props):
        """A label showing text, a string marked with N_(), in the current language."""
        label = Gtk.Label(xalign=0, **props)
        self.translated(lambda: label.set_text(_(text)))
        return label

    def build_language_row(self):
        self.language_combo = combo = Gtk.ComboBoxText()
        combo.append("", _("System default"))
        for code, name in LANGUAGES.items():
            combo.append(code, name)
        combo.set_active_id(saved_language())
        combo.connect("changed", self.on_language_changed)
        row = Gtk.Box(spacing=6)
        row.pack_end(combo, False, False, 0)
        row.pack_end(self.caption(N_("Language")), False, False, 0)
        return row

    def build_update_row(self):
        self.update_combo = combo = Gtk.ComboBoxText()
        combo.connect("changed", self.on_update_interval_changed)
        self.translated(self.fill_update_combo)
        row = Gtk.Box(spacing=6)
        row.pack_end(combo, False, False, 0)
        row.pack_end(self.caption(N_("Check for updates")), False, False, 0)
        return row

    def fill_update_combo(self):
        """Write the entries in the current language, keeping the selection."""
        combo = self.update_combo
        combo.handler_block_by_func(self.on_update_interval_changed)
        combo.remove_all()
        for interval, label in UPDATE_LABELS.items():
            combo.append(interval, _(label))
        combo.set_active_id(self.state["update_interval"] if self.state else None)
        combo.handler_unblock_by_func(self.on_update_interval_changed)

    def on_update_interval_changed(self, combo):
        interval = combo.get_active_id()
        if interval:
            self.send({"update_interval": interval})

    def on_language_changed(self, combo):
        language = combo.get_active_id()
        if language is None:
            return
        save_language(language)
        set_language(language)
        # "System default" is the only entry written in the interface language.
        combo.handler_block_by_func(self.on_language_changed)
        combo.remove(0)
        combo.prepend("", _("System default"))
        combo.set_active_id(language)
        combo.handler_unblock_by_func(self.on_language_changed)
        for set_text in self.texts:
            set_text()
        self.tray.retranslate()
        if self.state:
            self.show_state(self.state)
        if self.dirty:
            self.status_label.set_text(_("Changes not applied"))

    def build_readings(self):
        grid = Gtk.Grid(column_spacing=12, column_homogeneous=True)
        self.temp_value = self.add_reading(grid, 0, N_("Temperature"))
        self.watts_value = self.add_reading(grid, 1, N_("Power"))
        self.freq_value = self.add_reading(grid, 2, N_("Frequency"))
        self.box.add(grid)
        self.cores_label = Gtk.Label(xalign=0, wrap=True)
        self.limits_label = Gtk.Label(xalign=0)
        self.box.add(self.cores_label)
        self.box.add(self.limits_label)

    def add_reading(self, grid, column, caption):
        value = Gtk.Label(label="–")
        grid.attach(value, column, 0, 1, 1)
        label = self.caption(caption)
        label.set_xalign(0.5)
        grid.attach(label, column, 1, 1, 1)
        return value

    def build_controls(self, state):
        """Build the profile and limit controls once the CPU is known."""
        row = Gtk.Box(spacing=12)
        self.radios = {}
        group = None
        for name, label in PROFILE_LABELS.items():
            radio = Gtk.RadioButton.new_from_widget(group)
            self.translated(lambda radio=radio, label=label: radio.set_label(_(label)))
            group = group or radio
            radio.connect("toggled", self.on_profile_toggled, name)
            self.radios[name] = radio
            row.add(radio)
        self.box.add(row)

        bounds, writable = state["bounds"], state["writable"]
        grid = Gtk.Grid(column_spacing=12, row_spacing=6)
        self.turbo_switch = Gtk.Switch(halign=Gtk.Align.START)
        self.turbo_switch.connect("notify::active", self.on_turbo_switched)
        grid.attach(self.caption(N_("Turbo")), 0, 0, 1, 1)
        grid.attach(self.turbo_switch, 1, 0, 1, 1)

        line = 1
        for key in state["fields"]:
            if key == "ratios":
                for index in range(state["cpu"]["cores"]):
                    scale = self.make_scale(*bounds["ratio"], lambda v: ghz(v * 100))
                    scale.connect("value-changed", self.on_ratio_changed, index)
                    self.ratio_scales.append(scale)
                    caption = Gtk.Label(xalign=0)
                    self.translated(
                        lambda caption=caption, count=index + 1: caption.set_text(
                            _("1 active core") if count == 1 else _("{} active cores").format(count)
                        )
                    )
                    grid.attach(caption, 0, line, 1, 1)
                    grid.attach(scale, 1, line, 1, 1)
                    line += 1
                continue
            text, formatter, step = FIELDS[key]
            scale = self.make_scale(*bounds[key], formatter, step)
            scale.connect("value-changed", self.on_setting_changed, key)
            scale.set_sensitive(writable[key])
            if key == "tau":
                # The CPU holds only some durations: the slider stops on those.
                self.tau_steps = state.get("tau_steps") or []
                for step in self.tau_steps:
                    scale.add_mark(step, Gtk.PositionType.BOTTOM, None)
            self.scales[key] = scale
            grid.attach(self.caption(text), 0, line, 1, 1)
            grid.attach(scale, 1, line, 1, 1)
            line += 1

        if "undervolt" in bounds:
            # Independent of the profiles: applied on its own, then with every profile.
            self.uv_scale = self.make_scale(*bounds["undervolt"], lambda v: f"{v:.0f} mV", 5)
            self.uv_scale.connect("value-changed", self.on_uv_changed)
            self.uv_button = Gtk.Button(sensitive=False)
            self.translated(lambda: self.uv_button.set_label(_("Apply")))
            self.uv_button.connect("clicked", lambda _button: self.send_undervolt())
            grid.attach(self.caption(N_("Undervolt")), 0, line, 1, 1)
            grid.attach(self.uv_scale, 1, line, 1, 1)
            grid.attach(self.uv_button, 2, line, 1, 1)
            self.uv_note = Gtk.Label(xalign=0, wrap=True, max_width_chars=50)
            grid.attach(self.uv_note, 0, line + 1, 3, 1)
        self.box.add(grid)

        footer = Gtk.Box(spacing=12)
        self.status_label = Gtk.Label(xalign=0, wrap=True, max_width_chars=40)
        self.apply_button = Gtk.Button()
        self.translated(lambda: self.apply_button.set_label(_("Apply")))
        self.apply_button.get_style_context().add_class("suggested-action")
        self.apply_button.connect("clicked", lambda _button: self.send_custom())
        footer.pack_start(self.status_label, True, True, 0)
        footer.pack_end(self.apply_button, False, False, 0)
        self.box.add(footer)

        if state.get("update_interval"):  # absent for installs made by a package
            self.box.pack_end(self.build_update_row(), False, False, 0)

        self.ratios_writable = writable.get("ratios", False)
        self.controls_built = True
        self.box.show_all()

    @staticmethod
    def make_scale(low, high, formatter, step=1):
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, low, high, step)
        scale.set_hexpand(True)
        scale.set_digits(0)
        scale.set_value_pos(Gtk.PositionType.RIGHT)
        scale.connect("format-value", lambda _scale, value: formatter(value))
        return scale

    def present_window(self):
        self.show_all()
        self.present()

    def on_delete(self, _window, _event):
        if self.tray.available:
            self.hide()
            return True
        self.quit()
        return False

    def check_update(self):
        try:
            mtime = os.stat(self.program).st_mtime_ns
        except OSError:
            return GLib.SOURCE_CONTINUE  # being replaced
        # Restart once the new file has stayed the same for one check, and no edit is pending.
        if mtime != self.program_mtime and mtime == self.seen_mtime and not self.dirty:
            self.restart()
        self.seen_mtime = mtime
        return GLib.SOURCE_CONTINUE

    def restart(self):
        try:
            self.helper.stdin.close()
            self.helper.wait(timeout=5)  # else it stays a zombie of the new process
        except (BrokenPipeError, subprocess.TimeoutExpired):
            pass
        os.environ["TURBOCTL_UPDATED"] = "1"
        arguments = [] if self.get_visible() else ["--tray"]
        os.execv(sys.executable, [sys.executable, self.program, *arguments])

    def quit(self):
        # Closing stdin makes the root helper exit.
        try:
            self.helper.stdin.close()
        except BrokenPipeError:
            pass
        self.app.quit()

    def read_helper(self):
        for line in self.helper.stdout:
            GLib.idle_add(self.on_state, json.loads(line))
        GLib.idle_add(self.on_helper_exit)

    def send(self, request):
        try:
            self.helper.stdin.write(json.dumps(request) + "\n")
            self.helper.stdin.flush()
        except (BrokenPipeError, ValueError):
            pass

    def choose_profile(self, name):
        self.dirty = False
        self.send({"profile": name})

    def send_custom(self):
        self.dirty = False
        custom = {"turbo": self.turbo_switch.get_active()}
        if self.ratio_scales:
            custom["ratios"] = [int(scale.get_value()) for scale in self.ratio_scales]
        for key, scale in self.scales.items():
            custom[key] = int(scale.get_value())
        self.send({"custom": custom})

    def send_undervolt(self):
        self.uv_dirty = False
        self.uv_button.set_sensitive(False)
        self.send({"undervolt": round(self.uv_scale.get_value())})

    def on_uv_changed(self, _scale):
        if not self.loading:
            self.uv_dirty = True
            self.uv_button.set_sensitive(True)

    def mark_modified(self):
        self.dirty = True
        self.loading = True
        self.radios["custom"].set_active(True)
        self.loading = False
        self.status_label.set_text(_("Changes not applied"))

    def on_profile_toggled(self, radio, name):
        if self.loading or not radio.get_active():
            return
        if name == "custom":
            self.send_custom()
        else:
            self.choose_profile(name)

    def on_turbo_switched(self, _switch, _param):
        self.update_sensitivity()
        if not self.loading:
            self.mark_modified()

    def on_setting_changed(self, scale, key):
        if self.loading:
            return
        if key == "tau" and self.tau_steps:
            self.snap_tau(scale)
        # PL2 can never be below PL1: moving one past the other drags it along.
        pl1, pl2 = self.scales.get("pl1"), self.scales.get("pl2")
        if pl1 and pl2 and pl2.get_value() < pl1.get_value():
            self.loading = True
            (pl2 if key == "pl1" else pl1).set_value(scale.get_value())
            self.loading = False
        self.mark_modified()

    def snap_tau(self, scale):
        value, previous = scale.get_value(), self.tau_previous
        if value == previous:
            return
        # Toward the move, so a one-second key press still reaches the next step.
        ahead = [] if previous is None else [
            step for step in self.tau_steps if step != previous and (step > previous) == (value > previous)
        ]
        target = min(ahead or self.tau_steps, key=lambda step: abs(step - value))
        self.tau_previous = target
        if target != value:
            self.loading = True
            scale.set_value(target)
            self.loading = False

    def on_ratio_changed(self, scale, index):
        if self.loading:
            return
        value = scale.get_value()
        self.loading = True
        # The CPU expects the ceiling to never rise with more active cores.
        for other, neighbour in enumerate(self.ratio_scales):
            if (other < index and neighbour.get_value() < value) or (other > index and neighbour.get_value() > value):
                neighbour.set_value(value)
        self.loading = False
        self.mark_modified()

    def update_sensitivity(self):
        for scale in self.ratio_scales:
            scale.set_sensitive(self.ratios_writable and self.turbo_switch.get_active())

    def load_controls(self, state):
        self.loading = True
        self.radios[state["profile"]].set_active(True)
        self.turbo_switch.set_active(state["turbo"])
        values = state["values"]
        for scale, ratio in zip(self.ratio_scales, values.get("ratios", [])):
            scale.set_value(ratio)
        for key, scale in self.scales.items():
            if values.get(key) is not None:
                scale.set_value(values[key])
        self.tau_previous = values.get("tau")
        self.loading = False
        self.update_sensitivity()

    def on_state(self, state):
        self.state = state
        if not self.controls_built:
            self.build_controls(state)
        combo = getattr(self, "update_combo", None)
        if combo and state["update_interval"] and combo.get_active_id() != state["update_interval"]:
            combo.handler_block_by_func(self.on_update_interval_changed)
            combo.set_active_id(state["update_interval"])
            combo.handler_unblock_by_func(self.on_update_interval_changed)
        self.show_state(state)
        self.tray.update(state)

        if self.uv_scale and not self.uv_dirty:
            self.loading = True
            self.uv_scale.set_value(state["undervolt"])
            self.loading = False
        if not self.dirty:
            self.load_controls(state)
        return GLib.SOURCE_REMOVE

    def show_state(self, state):
        """Write the texts that depend on the state, in the current language."""
        cpu = state["cpu"]
        text = f"{cpu['name']} · {cpu['generation']}"
        if not cpu["tested"]:
            text += "\n" + _("This CPU generation is untested: check the readings before relying on it.")
        for note in state.get("notes", []):
            text += "\n" + _(NOTES.get(note, note))
        if self.updated:
            text += "\n" + _("Updated to turboctl {}.").format(state["version"])
        self.cpu_label.set_text(text)

        temp = state["temp"]
        color = "#d0342c" if temp >= 90 else "#e08a00" if temp >= 85 else None
        self.temp_value.set_markup(big(f"{temp} °C", color))
        self.watts_value.set_markup(big(watts(state["watts"])))
        self.freq_value.set_markup(big(ghz(max(state["freqs"]))))
        self.cores_label.set_text(_("Cores: ") + " / ".join(ghz(freq) for freq in state["freqs"]))
        limits = ", ".join(_(LIMIT_LABELS.get(name, name)) for name in state["limits"]) or _("none")
        self.limits_label.set_text(_("Active limit: ") + limits)
        if self.uv_scale:
            crash = state["undervolt_crash"]
            self.uv_note.set_text(
                _("Unclean shutdown with {} mV: undervolt reset to 0 mV for safety.").format(crash) if crash else ""
            )
        if not self.dirty:
            label = _(PROFILE_LABELS[state["profile"]])
            self.status_label.set_text(state["error"] or _("Active profile: ") + label)

    def on_helper_exit(self):
        if self.state:
            message = _("The control service stopped.")
        else:
            message = _("Authorization refused or CPU not supported. Run “sudo turboctl status” for details.")
        dialog = Gtk.MessageDialog(
            transient_for=self, message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.CLOSE, text=message
        )
        dialog.run()
        self.app.quit()
        return GLib.SOURCE_REMOVE


class App(Gtk.Application):
    """Single instance: launching again from the menu shows the running window."""

    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.panel = None

    def do_command_line(self, command_line):
        tray_only = "--tray" in command_line.get_arguments()[1:]
        if self.panel is None:
            self.panel = Panel(self)
            self.hold()  # keep running while the window is hidden
            if tray_only:
                GLib.timeout_add_seconds(TRAY_WAIT_SECONDS, self.quit_without_tray)
        if not tray_only:
            self.panel.present_window()
        return 0

    def quit_without_tray(self):
        # No tray host showed up (e.g. GNOME without the AppIndicator extension).
        if not self.panel.tray.available and not self.panel.get_visible():
            self.panel.quit()
        return GLib.SOURCE_REMOVE


def main():
    sys.exit(App().run(sys.argv))


if __name__ == "__main__":
    main()
