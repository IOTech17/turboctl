"""GTK control panel and tray icon for turboctl.

turboctl-gui          open the window (or show it if already running)
turboctl-gui --tray   start hidden in the tray, used at login
"""
import gettext
import json
import locale
import os
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib, Gtk  # noqa: E402

APP_ID = "io.github.iotech17.turboctl"
SBINDIR = "@SBINDIR@"  # filled in by install.sh
LOCALEDIR = "@LOCALEDIR@"
if SBINDIR.startswith("@"):  # running from the source tree
    SBINDIR, LOCALEDIR = "/usr/sbin", None

CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "turboctl", "gui.json")
LANGUAGES = {"en": "English", "fr": "Français"}  # each shown in its own language


def saved_language():
    """The language chosen in the window, or "" to follow the system."""
    try:
        with open(CONFIG, encoding="utf-8") as file:
            language = json.load(file).get("language", "")
    except (OSError, ValueError, AttributeError):
        return ""
    return language if language in LANGUAGES else ""


def save_language(language):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w", encoding="utf-8") as file:
        json.dump({"language": language}, file)


if saved_language():
    os.environ["LANGUAGE"] = saved_language()  # read by gettext, here and in GTK
try:
    locale.setlocale(locale.LC_ALL, "")
except locale.Error:
    pass
_ = gettext.translation("turboctl", LOCALEDIR, fallback=True).gettext

# Without --disable-internal-agent, pkexec started from a terminal asks for the
# password on the tty and reads it from our stdin pipe, so authentication fails.
HELPER = ["pkexec", "--disable-internal-agent", SBINDIR + "/turboctl", "serve"]
TRAY_WAIT_SECONDS = 60  # at login the panel may start after us

PROFILE_LABELS = {"off": _("Turbo off"), "cool": _("Cool"), "stock": _("Stock"), "custom": _("Custom")}
LIMIT_LABELS = {
    "MAX_TURBO": _("frequency ceiling"),
    "PL1": _("power (PL1)"),
    "PL2": _("power (PL2)"),
    "THERMAL": _("temperature"),
    "PROCHOT": "PROCHOT",
}


def number(value):
    return locale.format_string("%.1f", value)


def ghz(ratio):
    return number(ratio / 10) + " GHz"


def watts(value):
    return number(value) + " W"


def big(text, color=None):
    color_attr = f' foreground="{color}"' if color else ""
    return f'<span size="x-large" weight="bold"{color_attr}>{GLib.markup_escape_text(text)}</span>'


