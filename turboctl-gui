CONFIG = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "turboctl", "gui.json")
LANGUAGES = {"en": "English", "fr": "Français"}  # each shown in its own language


def saved_language():
    """The language chosen in the window, or "" to follow the system."""
    try:
        with open(CONFIG, encoding="utf-8") as file:
            language = json.load(file).get("language", "")
    except (OSError, ValueError, AttributeError):
        return ""
    return language if language in LANGUAGES else ""


def save_language(language):
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    with open(CONFIG, "w", encoding="utf-8") as file:
        json.dump({"language": language}, file)


try:
    locale.setlocale(locale.LC_ALL, "")
except locale.Error:
    pass
translation = gettext.NullTranslations()


def set_language(language):
    """Translate from now on into language, or into the system language for ""."""
    global translation
    languages = [language] if language else None  # None: LANGUAGE, LC_ALL, LC_MESSAGES, LANG
    translation = gettext.translation("turboctl", LOCALEDIR, languages=languages, fallback=True)


def _(text):
    return translation.gettext(text)


def N_(text):
    """Mark text for translation; it is translated where it is shown."""
    return text


set_language(saved_language())

