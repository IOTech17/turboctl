class Unsupported(Exception):
    """The CPU, the kernel or the firmware does not allow a feature."""


# ---------------------------------------------------------------- low level


def read_text(path):
    with open(path) as f:
        return f.read().strip()


def write_text(path, text):
    with open(path, "w") as f:
        f.write(text)


def remove(path):
    try:
        os.remove(path)
    except FileNotFoundError:
        pass


def cpus():
    return sorted(int(name[3:]) for name in os.listdir("/sys/devices/system/cpu") if re.fullmatch(r"cpu\d+", name))


def core_cpus():
    """Return one logical CPU per physical core."""
    first = set()
    for cpu in cpus():
        siblings = read_text(f"/sys/devices/system/cpu/cpu{cpu}/topology/thread_siblings_list")
        first.add(int(re.split(r"[,-]", siblings)[0]))
    return sorted(first)


def rdmsr(reg, cpu=0):
    fd = os.open(f"/dev/cpu/{cpu}/msr", os.O_RDONLY)
    try:
        return struct.unpack("<Q", os.pread(fd, 8, reg))[0]
    finally:
        os.close(fd)


def wrmsr(reg, value):
    for cpu in cpus():
        fd = os.open(f"/dev/cpu/{cpu}/msr", os.O_WRONLY)
        try:
            os.pwrite(fd, struct.pack("<Q", value), reg)
        except PermissionError as err:
            raise OSError(
                errno.EPERM, "the kernel refused an MSR write (msr.allow_writes=off or kernel lockdown)"
            ) from err
        finally:
            os.close(fd)


def ensure_msr():
    if not os.path.exists("/dev/cpu/0/msr"):
        subprocess.run(["modprobe", "msr"], check=False)
    if not os.path.exists("/dev/cpu/0/msr"):
        sys.exit("turboctl: /dev/cpu/0/msr is missing; the kernel needs CONFIG_X86_MSR")
    try:
        mode = read_text(LOCKDOWN)
    except OSError:
        return
    if "[none]" not in mode:
        sys.exit(f"turboctl: kernel lockdown is active ({mode}), MSR writes are blocked")


# ---------------------------------------------------------------- CPU


def detect_cpu():
    """Return what this CPU is and what it lets us change, or exit if unsupported."""
    fields = {}
    for line in read_text("/proc/cpuinfo").split("\n\n")[0].splitlines():
        key, _, value = line.partition(":")
        fields[key.strip()] = value.strip()
    model = int(fields.get("model", "0"))
    name = fields.get("model name", "unknown CPU")
    if fields.get("vendor_id") == "AuthenticAMD":
        return detect_amd(fields)
    if fields.get("vendor_id") != "GenuineIntel" or fields.get("cpu family") != "6" or model not in SUPPORTED_MODELS:
        sys.exit(
            f"turboctl: {name} (model {model:#x}) is not supported; "
            "supported CPUs are Intel Core 4th to 10th generation (Haswell to Comet Lake) and AMD Ryzen"
        )
    cores = int(fields.get("cpu cores", "0"))
    if not 1 <= cores <= MAX_CORES:
        sys.exit(f"turboctl: {name} has {cores} cores; at most {MAX_CORES} are supported")

    ensure_msr()
    platform = rdmsr(MSR_PLATFORM_INFO)
    tjmax = (rdmsr(MSR_TEMP_TARGET) >> 16) & 0xFF or 100
    return {
        "name": re.sub(r"\s+", " ", name),
        "model": model,
        "generation": SUPPORTED_MODELS[model],
        "tested": model in TESTED_MODELS,
        "cores": cores,
        "tjmax": tjmax,
        "base_ratio": (platform >> 8) & 0xFF,
        "ratio_writable": bool(platform >> 28 & 1),
        "tcc_writable": bool(platform >> 30 & 1),
        "power_unit": 1 << (rdmsr(MSR_RAPL_UNIT) & 0xF),  # steps per watt
    }


def get_ratios(cpu):
    value = rdmsr(MSR_TURBO_RATIO_LIMIT)
    return [(value >> (8 * i)) & 0xFF for i in range(cpu["cores"])]


def get_tcc(cpu):
    return cpu["tjmax"] - ((rdmsr(MSR_TEMP_TARGET) >> 24) & 0x3F)


def msr_pl1(cpu):
    return (rdmsr(MSR_PKG_POWER_LIMIT) & 0x7FFF) / cpu["power_unit"]


def mchbar_base():
    with open(MCHBAR_PCI_CONFIG, "rb") as f:
        value = struct.unpack("<Q", f.read(0x50)[0x48:0x50])[0]
    if not value & 1:
        raise Unsupported("MCHBAR is disabled by the firmware")
    return value & 0x7FFFFF8000


def power_limits(cpu, write_watts=None):
    """Return (PL1 W, PL2 W) from the MCHBAR mirror, optionally setting PL1 first.

    MSR 0x610 is often locked by the firmware; this mirror usually is not,
    and the CPU enforces the lower of the two.
    """
    address = mchbar_base() + MCHBAR_PL_OFFSET
    page, index = address & ~0xFFF, (address & 0xFFF) // 4
    try:
        fd = os.open("/dev/mem", (os.O_RDWR if write_watts else os.O_RDONLY) | os.O_SYNC)
    except PermissionError as err:
        raise Unsupported("/dev/mem access refused; boot with iomem=relaxed") from err
    prot = mmap.PROT_READ | (mmap.PROT_WRITE if write_watts else 0)
    try:
        try:
            area = mmap.mmap(fd, 4096, mmap.MAP_SHARED, prot, offset=page)
        except OSError as err:
            raise Unsupported(
                "the kernel refused to map MCHBAR (CONFIG_IO_STRICT_DEVMEM); boot with iomem=relaxed"
            ) from err
        regs = memoryview(area).cast("I")  # keeps accesses 32-bit wide
        if write_watts:
            regs[index] = (regs[index] & ~0x7FFF) | round(write_watts * cpu["power_unit"])
        low, high = regs[index], regs[index + 1]
        regs.release()
        area.close()
    finally:
        os.close(fd)
    return (low & 0x7FFF) / cpu["power_unit"], (high & 0x7FFF) / cpu["power_unit"]


def get_turbo():
    if os.path.exists(NO_TURBO):
        return read_text(NO_TURBO) == "0"
    return read_text(BOOST) == "1"


def set_turbo(enabled):
    if os.path.exists(NO_TURBO):
        write_text(NO_TURBO, "0" if enabled else "1")
    elif os.path.exists(BOOST):
        write_text(BOOST, "1" if enabled else "0")
    else:
        raise OSError(errno.ENOENT, "no turbo switch (neither intel_pstate nor acpi-cpufreq boost)")


def clear_turbo_disable_bit():
    # Firmware can set this bit, which makes turbo impossible to enable.
    misc = rdmsr(MSR_MISC_ENABLE)
    if misc & TURBO_DISABLE_BIT:
        wrmsr(MSR_MISC_ENABLE, misc & ~TURBO_DISABLE_BIT)


# ---------------------------------------------------------------- AMD


def policies():
    return sorted(
        (os.path.join(CPUFREQ, name) for name in os.listdir(CPUFREQ) if name.startswith("policy")),
        key=lambda path: int(path.rsplit("policy", 1)[1]),
    )


def round_mhz(khz):
    return int(khz) // 100000 * 100  # down to 100 MHz


class Smu:
    """Mailboxes of the AMD system management unit, reached through SMN registers.

    Every request holds a lock: two interleaved requests would write to the wrong register.
    """

    def __init__(self):
        self.fd = os.open(MCHBAR_PCI_CONFIG, os.O_RDWR)
        os.makedirs(os.path.dirname(SMU_LOCK), exist_ok=True)
        self.lock = os.open(SMU_LOCK, os.O_RDWR | os.O_CREAT, 0o600)
        self.table_address = None

    def read(self, address):
        os.pwrite(self.fd, struct.pack("<I", address), SMN_INDEX)
        return struct.unpack("<I", os.pread(self.fd, 4, SMN_DATA))[0]

    def write(self, address, value):
        os.pwrite(self.fd, struct.pack("<I", address), SMN_INDEX)
        os.pwrite(self.fd, struct.pack("<I", value), SMN_DATA)

    def request(self, mailbox, message, argument=0):
        """Send one message; return the response code and the six argument registers."""
        message_reg, response_reg, args_reg = mailbox
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        try:
            self.write(response_reg, 0)
            for index in range(6):
                self.write(args_reg + 4 * index, argument if index == 0 else 0)
            self.write(message_reg, message)
            deadline = time.monotonic() + 1
            while not (response := self.read(response_reg)):
                if time.monotonic() > deadline:
                    raise OSError(errno.ETIMEDOUT, f"the SMU did not answer message {message:#x}")
                time.sleep(0.001)
            return response, [self.read(args_reg + 4 * index) for index in range(6)]
        finally:
            fcntl.flock(self.lock, fcntl.LOCK_UN)

    def test(self):
        for mailbox in (SMU_MP1, SMU_PSMU):
            if self.request(mailbox, SMU_TEST, 0x47)[0] != SMU_OK:
                raise Unsupported("the SMU does not answer")

    def open_table(self):
        """Find the PM table, where the SMU publishes its limits and readings."""
        response, args = self.request(SMU_PSMU, SMU_TABLE_VERSION)
        if response != SMU_OK or not args[0]:
            raise Unsupported("the SMU does not report its PM table")
        self.table_version = args[0]
        response, args = self.request(SMU_PSMU, SMU_TABLE_ADDRESS)
        address = args[1] << 32 | args[0]
        if response != SMU_OK or not address:
            raise Unsupported("the SMU does not report its PM table address")
        self.table_address = address
        self.table()  # fails here rather than later if /dev/mem is refused

    def table(self):
        """Return the start of the PM table, refreshed, as a function of offset -> float."""
        for _attempt in range(3):
            if self.request(SMU_PSMU, SMU_TABLE_TRANSFER)[0] == SMU_OK:
                break
            time.sleep(0.01)  # rejected when asked too often
        page, offset = self.table_address & ~0xFFF, self.table_address & 0xFFF
        try:
            fd = os.open("/dev/mem", os.O_RDONLY)
        except PermissionError as err:
            raise Unsupported("/dev/mem access refused") from err
        try:
            area = mmap.mmap(fd, offset + PM_TABLE_BYTES, mmap.MAP_SHARED, mmap.PROT_READ, offset=page)
        except OSError as err:
            raise Unsupported("the kernel refused to map the SMU table; boot with iomem=relaxed") from err
        finally:
            os.close(fd)
        data = area[offset:offset + PM_TABLE_BYTES]
        area.close()
        return lambda at: round(struct.unpack_from("<f", data, at)[0], 1)

    def set(self, message, value):
        response = self.request(SMU_MP1, message, value)[0]
        if response != SMU_OK:
            raise OSError(errno.EIO, f"the SMU refused message {message:#x} (response {response:#x})")


def detect_amd(fields):
    name = re.sub(r"\s+", " ", fields.get("model name", "unknown CPU"))
    family, model = int(fields.get("cpu family", "0")), int(fields.get("model", "0"))
    if family < 0x17 or not os.path.exists(BOOST) or not policies():
        sys.exit(f"turboctl: {name} is not supported; AMD needs Ryzen with the amd-pstate or acpi-cpufreq driver")
    policy = policies()[0]
    cpu = {
        "vendor": "amd",
        "name": name,
        "generation": AMD_SMU_MODELS.get((family, model), f"family {family:#x} model {model:#x}"),
        "tested": (family, model) in AMD_TESTED_MODELS,
        "cores": int(fields.get("cpu cores", "0")) or len(core_cpus()),
        # cpuinfo_max_freq drops to the base frequency while turbo is off; amd_pstate_max_freq does not.
        "max_freq": round_mhz(read_text(policy + "/amd_pstate_max_freq" if os.path.exists(
            policy + "/amd_pstate_max_freq") else policy + "/cpuinfo_max_freq")),
        "min_freq": AMD_MIN_FREQ,
        "smu": None,
        "smu_note": None,
        "tctl": False,
    }
    if (family, model) not in AMD_SMU_MODELS:
        cpu["smu_note"] = "smu_unsupported"
        return cpu
    try:
        smu = Smu()
        smu.test()
        smu.open_table()
    except (OSError, Unsupported) as err:
        cpu["smu_note"] = "smu_unavailable"
        cpu["smu_error"] = str(err)
        return cpu
    cpu["smu"] = smu
    cpu["tctl"] = smu.table_version in PM_TCTL_TABLES
    return cpu


def amd_limits(cpu):
    """Return the limits in place: max frequency, and power and temperature from the SMU."""
    limits = {"max_freq": round_mhz(read_text(policies()[0] + "/scaling_max_freq"))}
    if cpu["smu"]:
        table = cpu["smu"].table()
        limits["power"] = table(PM_STAPM_LIMIT)
        limits["slow"] = table(PM_SLOW_LIMIT)
        limits["fast"] = table(PM_FAST_LIMIT)
        if cpu["tctl"]:
            limits["temp"] = table(PM_TCTL_LIMIT)
    return limits


def amd_fields(cpu):
    return ["max_freq"] + (["power"] if cpu["smu"] else []) + (["temp"] if cpu["tctl"] else [])


def amd_bounds(cpu, factory):
    limits = {"max_freq": [cpu["min_freq"], cpu["max_freq"]]}
    if "power" in factory:
        sustained = int(max(factory["power"], factory["slow"]))
        limits["power"] = [max(5, round(sustained * 0.3)), sustained]
    if "temp" in factory:
        limits["temp"] = [60, int(factory["temp"])]
    return limits


def amd_stock(cpu, factory):
    stock = {"max_freq": cpu["max_freq"]}
    if "power" in factory:
        stock["power"] = int(max(factory["power"], factory["slow"]))
    if "temp" in factory:
        stock["temp"] = int(factory["temp"])
    return stock


def amd_cool(cpu, factory):
    limits = amd_bounds(cpu, factory)
    cool = {"max_freq": cpu["max_freq"]}
    if "power" in limits:
        cool["power"] = max(limits["power"][0], int(limits["power"][1] * 0.65))
    if "temp" in limits:
        cool["temp"] = max(limits["temp"][0], min(limits["temp"][1], 85))
    return cool


def amd_valid(profile, cpu, factory):
    limits = amd_bounds(cpu, factory)
    return (
        set(profile) == {"turbo", *limits}
        and isinstance(profile["turbo"], bool)
        and all(type(profile[key]) is int and low <= profile[key] <= high for key, (low, high) in limits.items())
        and profile["max_freq"] % 100 == 0
    )


def amd_write_max_freq(mhz):
    """Cap every core; run after the turbo switch, which resets the cap."""
    for policy in policies():
        # Without turbo the hardware ceiling drops to the base frequency.
        target = min(mhz * 1000, int(read_text(policy + "/cpuinfo_max_freq")))
        write_text(policy + "/scaling_max_freq", str(target))
        # Right after a turbo switch, the kernel takes a moment to apply the new cap.
        for _ in range(20):
            applied = int(read_text(policy + "/scaling_max_freq"))
            if round_mhz(applied) == round_mhz(target):
                break
            time.sleep(0.05)
        else:
            raise OSError(errno.EIO, f"max frequency not applied, read {applied // 1000} MHz")


def amd_write_limits(cpu, profile):
    smu = cpu["smu"]
    if not smu:
        return
    # STAPM is the long average and slow PPT the sustained one: both get the same limit.
    smu.set(SMU_SET_STAPM, profile["power"] * 1000)
    smu.set(SMU_SET_SLOW, profile["power"] * 1000)
    if cpu["tctl"]:
        smu.set(SMU_SET_TCTL, profile["temp"])
    applied = amd_limits(cpu)
    if applied["power"] != profile["power"] or applied["slow"] != profile["power"]:
        raise OSError(errno.EIO, f"power limit not applied, read {applied['power']:g} / {applied['slow']:g} W")
    if cpu["tctl"] and applied["temp"] != profile["temp"]:
        raise OSError(errno.EIO, f"temperature limit not applied, read {applied['temp']:g} C")


def hwmon(name):
    for entry in os.listdir("/sys/class/hwmon"):
        path = os.path.join("/sys/class/hwmon", entry)
        try:
            if read_text(path + "/name") == name:
                return path
        except OSError:
            continue
    return None


def amd_temp():
    path = hwmon("k10temp")
    return round(int(read_text(path + "/temp1_input")) / 1000) if path else 0


def amd_power_sampler():
    """Return a function giving the average package watts since its previous call (RAPL)."""
    zone = "/sys/class/powercap/intel-rapl:0"  # the kernel names it intel-rapl on AMD too
    if not os.path.exists(zone + "/energy_uj"):
        return lambda: 0.0
    wrap = int(read_text(zone + "/max_energy_range_uj")) + 1
    last_energy, last_time = int(read_text(zone + "/energy_uj")), time.monotonic()

    def sample():
        nonlocal last_energy, last_time
        energy, now = int(read_text(zone + "/energy_uj")), time.monotonic()
        watts = ((energy - last_energy) % wrap) / 1e6 / max(now - last_time, 1e-3)
        last_energy, last_time = energy, now
        return watts

    return sample


def amd_active_limits(cpu):
    if not cpu["smu"]:
        return []
    try:
        table = cpu["smu"].table()
    except (OSError, Unsupported):
        return []
    limits = []
    if table(PM_STAPM_VALUE) >= table(PM_STAPM_LIMIT) * 0.97 or table(PM_SLOW_VALUE) >= table(PM_SLOW_LIMIT) * 0.97:
        limits.append("POWER")
    if cpu["tctl"] and table(PM_TCTL_VALUE) >= table(PM_TCTL_LIMIT) - 1:
        limits.append("THERMAL")
    return limits


def amd_freqs():
    path = "/sys/devices/system/cpu/cpu{}/cpufreq/scaling_cur_freq"
    return [round(int(read_text(path.format(c))) / 1000) for c in core_cpus()]


# ---------------------------------------------------------------- profiles


def is_amd(cpu):
    return cpu.get("vendor") == "amd"


def factory_limits(cpu):
    """Return the limits the firmware set at boot."""
    try:
        with open(FACTORY_FILE) as f:
            factory = json.load(f)
        if is_amd(cpu) and set(amd_limits(cpu)) <= set(factory):
            return factory
        if not is_amd(cpu) and len(factory["ratios"]) == cpu["cores"]:
            return factory
    except (OSError, ValueError, KeyError, TypeError):
        pass
    # Nothing written yet this boot, so the registers still hold the factory values.
    if is_amd(cpu):
        return dict(amd_limits(cpu), max_freq=cpu["max_freq"])
    return {"ratios": get_ratios(cpu), "tcc": get_tcc(cpu), "pl1": msr_pl1(cpu)}


def record_factory_limits(cpu):
    """Save the factory limits before the first write of this boot (/run is emptied at boot)."""
    if not os.path.exists(FACTORY_FILE):
        os.makedirs(os.path.dirname(FACTORY_FILE), exist_ok=True)
        with open(FACTORY_FILE, "w") as f:
            json.dump(factory_limits(cpu), f)


def bounds(cpu, factory):
    if is_amd(cpu):
        return amd_bounds(cpu, factory)
    return {
        "ratio": [cpu["base_ratio"], max(factory["ratios"])],
        "pl1": [max(5, round(factory["pl1"] * 0.3)), int(factory["pl1"])],
        "tcc": [max(60, cpu["tjmax"] - 35), cpu["tjmax"]],
        "undervolt": [UNDERVOLT_MIN, 0],
    }


def build_profiles(cpu, factory):
    if is_amd(cpu):
        stock, cool = amd_stock(cpu, factory), amd_cool(cpu, factory)
    else:
        stock = {"ratios": factory["ratios"], "pl1": int(factory["pl1"]), "tcc": factory["tcc"]}
        limits = bounds(cpu, factory)
        # "cool": one ratio step less per extra active core, 65 % of PL1, throttle 15 C below TjMax.
        # On an i7-5700HQ this keeps a sustained all-core load around 85 C.
        cool = {
            "ratios": [max(cpu["base_ratio"], ratio - i) for i, ratio in enumerate(factory["ratios"])],
            "pl1": max(limits["pl1"][0], int(factory["pl1"] * 0.65)),
            "tcc": max(limits["tcc"][0], min(factory["tcc"], cpu["tjmax"] - 15)),
        }
    profiles = {
        "off": dict(stock, turbo=False),
        "cool": dict(cool, turbo=True),
        "stock": dict(stock, turbo=True),
    }
    custom = load_custom(cpu, factory)
    if custom:
        profiles["custom"] = custom
    return profiles


def valid_profile(profile, cpu, factory):
    if not isinstance(profile, dict):
        return False
    if is_amd(cpu):
        return amd_valid(profile, cpu, factory)
    limits = bounds(cpu, factory)
    ratios, pl1, tcc = profile.get("ratios"), profile.get("pl1"), profile.get("tcc")
    low, high = limits["ratio"]
    return (
        isinstance(profile.get("turbo"), bool)
        and isinstance(ratios, list)
        and len(ratios) == cpu["cores"]
        and all(type(r) is int and low <= r <= high for r in ratios)
        and ratios == sorted(ratios, reverse=True)  # the CPU expects no rise with more active cores
        and type(pl1) is int
        and limits["pl1"][0] <= pl1 <= limits["pl1"][1]
        and type(tcc) is int
        and limits["tcc"][0] <= tcc <= limits["tcc"][1]
    )


def load_custom(cpu, factory):
    try:
        with open(CUSTOM_FILE) as f:
            profile = json.load(f)
    except (OSError, ValueError):
        return None
    return profile if valid_profile(profile, cpu, factory) else None


def saved_profile(profiles):
    try:
        name = read_text(PROFILE_FILE)
    except OSError:
        return "off"
    return name if name in profiles else "off"


def save_profile(name):
    os.makedirs(STATE_DIR, exist_ok=True)
    write_text(PROFILE_FILE, name + "\n")


def write_limits(cpu, profile):
    if is_amd(cpu):
        amd_write_limits(cpu, profile)
        return
    if cpu["ratio_writable"]:
        old = rdmsr(MSR_TURBO_RATIO_LIMIT)
        mask = (1 << (8 * cpu["cores"])) - 1
        wrmsr(MSR_TURBO_RATIO_LIMIT, (old & ~mask) | sum(r << (8 * i) for i, r in enumerate(profile["ratios"])))
        if get_ratios(cpu) != profile["ratios"]:
            raise OSError(errno.EIO, f"turbo ratios not applied, read {get_ratios(cpu)}")

    if cpu["tcc_writable"]:
        offset = cpu["tjmax"] - profile["tcc"]
        wrmsr(MSR_TEMP_TARGET, (rdmsr(MSR_TEMP_TARGET) & ~(0x3F << 24)) | (offset << 24))
        if get_tcc(cpu) != profile["tcc"]:
            raise OSError(errno.EIO, f"throttle temperature not applied, read {get_tcc(cpu)} C")

    set_pl1(cpu, profile["pl1"])


def set_pl1(cpu, watts):
    try:
        applied = power_limits(cpu, watts)[0]
    except Unsupported:
        value = rdmsr(MSR_PKG_POWER_LIMIT)
        if value >> 63:  # locked by the firmware: the MMIO mirror was the only way
            raise
        wrmsr(MSR_PKG_POWER_LIMIT, (value & ~0x7FFF) | round(watts * cpu["power_unit"]))
        applied = msr_pl1(cpu)
    if applied != watts:
        raise OSError(errno.EIO, f"PL1 not applied, read {applied:g} W")


def lock(path):
    """Take an exclusive lock; release it with os.close() on the returned descriptor."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def apply(cpu, profiles, name):
    profile = profiles[name]
    fd = lock(APPLY_LOCK)  # keeps "watch" from restoring the previous limits halfway
    try:
        remove(APPLIED_FILE)
        record_factory_limits(cpu)
        if profile["turbo"] and not is_amd(cpu):
            clear_turbo_disable_bit()
        # Turbo stays off until every limit is confirmed, and stays off on failure.
        set_turbo(False)
        write_limits(cpu, profile)
        if is_amd(cpu):
            if cpu["smu"]:
                with open(APPLIED_FILE, "w") as f:
                    json.dump({key: profile[key] for key in ("power", "temp") if key in profile}, f)
            set_turbo(profile["turbo"])
            amd_write_max_freq(profile["max_freq"])
        else:
            write_undervolt(checked_undervolt())
            set_turbo(profile["turbo"])
    except (OSError, Unsupported) as err:
        try:
            set_turbo(False)
        except OSError:
            pass
        sys.exit(f"turboctl: {getattr(err, 'strerror', None) or err}; turbo left disabled")
    finally:
        os.close(fd)


def watch(cpu):
    """Write the AMD power and temperature limits again when the firmware raises them.

    A power profile change (power-profiles-daemon, amd_pmf) restores the firmware's power
    limits. Lower limits set by the firmware, as in power saving mode, are left in place.
    """
    if not is_amd(cpu) or not cpu["smu"]:
        return
    last_error = None
    while True:
        time.sleep(WATCH_SECONDS)
        fd = lock(APPLY_LOCK)
        try:
            with open(APPLIED_FILE) as f:
                applied = json.load(f)
            current = amd_limits(cpu)
            too_hot = "temp" in applied and current["temp"] > applied["temp"]
            if max(current["power"], current["slow"]) > applied["power"] or too_hot:
                amd_write_limits(cpu, applied)
                print(f"limits raised by the firmware, set back to {applied['power']} W", flush=True)
            last_error = None
        except FileNotFoundError:
            pass  # no profile applied yet this boot
        except (OSError, ValueError, KeyError, Unsupported) as err:
            if str(err) != last_error:
                print(f"turboctl: {err}", file=sys.stderr, flush=True)
                last_error = str(err)
        finally:
            os.close(fd)


# ---------------------------------------------------------------- undervolt


def boot_id():
    return read_text("/proc/sys/kernel/random/boot_id")


def valid_undervolt(mv):
    return type(mv) is int and UNDERVOLT_MIN <= mv <= 0


def saved_undervolt():
    try:
        mv = int(read_text(UNDERVOLT_FILE))
    except (OSError, ValueError):
        return 0
    return mv if valid_undervolt(mv) else 0


def offset_units(mv):
    """Encode millivolts as the 11-bit two's complement field of MSR 0x150 (1/1.024 mV steps)."""
    return round(mv * 1.024) & 0x7FF


def offset_mv(units):
    return round((units - 0x800 if units & 0x400 else units) / 1.024)


def read_voltage_offset(fd, plane):
    os.pwrite(fd, struct.pack("<Q", 0x8000001000000000 | plane << 40), MSR_VOLTAGE_OFFSET)
    return (struct.unpack("<Q", os.pread(fd, 8, MSR_VOLTAGE_OFFSET))[0] >> 21) & 0x7FF


def get_undervolt():
    fd = os.open("/dev/cpu/0/msr", os.O_RDWR)
    try:
        return offset_mv(read_voltage_offset(fd, UNDERVOLT_PLANES[0]))
    finally:
        os.close(fd)


def write_undervolt(mv):
    """Set the core and cache voltage offset and confirm it by reading it back."""
    # Marker first: if this offset freezes the machine, the next boot finds it and skips it.
    if mv:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(UNDERVOLT_PENDING, "w") as f:
            f.write(f"{boot_id()} {mv}\n")
            f.flush()
            os.fsync(f.fileno())
    units = offset_units(mv)
    fd = os.open("/dev/cpu/0/msr", os.O_RDWR)
    try:
        for plane in UNDERVOLT_PLANES:
            os.pwrite(fd, struct.pack("<Q", 0x8000001100000000 | plane << 40 | units << 21), MSR_VOLTAGE_OFFSET)
            if read_voltage_offset(fd, plane) != units:
                raise Unsupported("the firmware or microcode locks undervolting on this CPU")
    finally:
        os.close(fd)
    if not mv:
        remove(UNDERVOLT_PENDING)


def checked_undervolt():
    """Return the saved undervolt, reset to 0 if the previous boot died while undervolted."""
    try:
        marker = read_text(UNDERVOLT_PENDING).split()
    except FileNotFoundError:
        return saved_undervolt()
    if marker and marker[0] == boot_id():
        return saved_undervolt()  # same boot: resume from sleep or a plain re-apply
    write_text(UNDERVOLT_CRASH, (marker[1] if len(marker) > 1 else "?") + "\n")
    set_saved_undervolt(0)
    remove(UNDERVOLT_PENDING)
    return 0


def undervolt_crash():
    try:
        return read_text(UNDERVOLT_CRASH)
    except FileNotFoundError:
        return None


def set_saved_undervolt(mv):
    os.makedirs(STATE_DIR, exist_ok=True)
    write_text(UNDERVOLT_FILE, f"{mv}\n")


def set_undervolt(mv):
    write_undervolt(mv)
    set_saved_undervolt(mv)
    remove(UNDERVOLT_CRASH)


# ---------------------------------------------------------------- readings


def package_temp(cpu):
    return cpu["tjmax"] - ((rdmsr(MSR_PKG_THERM_STATUS) >> 16) & 0x7F)


def power_sampler():
    """Return a function giving the average package watts since its previous call."""
    joule_per_count = 0.5 ** ((rdmsr(MSR_RAPL_UNIT) >> 8) & 0x1F)
    last_energy, last_time = rdmsr(MSR_PKG_ENERGY) & 0xFFFFFFFF, time.monotonic()

    def sample():
        nonlocal last_energy, last_time
        energy, now = rdmsr(MSR_PKG_ENERGY) & 0xFFFFFFFF, time.monotonic()
        watts = ((energy - last_energy) & 0xFFFFFFFF) * joule_per_count / max(now - last_time, 1e-3)
        last_energy, last_time = energy, now
        return watts

    return sample


def active_limits():
    for reg in LIMIT_REASON_MSRS:
        try:
            reasons = rdmsr(reg)
        except OSError:
            continue
        return [name for bit, name in LIMIT_REASON_BITS.items() if reasons >> bit & 1]
    return []


def core_ratios():
    return [(rdmsr(MSR_PERF_STATUS, c) >> 8) & 0xFF for c in core_cpus()]


def cpu_temp(cpu):
    return amd_temp() if is_amd(cpu) else package_temp(cpu)


def cpu_power_sampler(cpu):
    return amd_power_sampler() if is_amd(cpu) else power_sampler()


def cpu_active_limits(cpu):
    return amd_active_limits(cpu) if is_amd(cpu) else active_limits()


def core_freqs(cpu):
    """MHz of each physical core."""
    return amd_freqs() if is_amd(cpu) else [ratio * 100 for ratio in core_ratios()]


def fields(cpu):
    return amd_fields(cpu) if is_amd(cpu) else ["ratios", "pl1", "tcc"]


def current_values(cpu):
    """The settings in place, by field name (None if unreadable)."""
    if is_amd(cpu):
        try:
            limits = amd_limits(cpu)
        except (OSError, Unsupported):
            return {}
        return {key: limits.get(key) for key in amd_fields(cpu)}
    try:
        pl1 = power_limits(cpu)[0]
    except (OSError, Unsupported):
        pl1 = None
    return {"ratios": get_ratios(cpu), "pl1": pl1, "tcc": get_tcc(cpu)}


def amd_status(cpu, profiles):
    note = "" if cpu["tested"] else "  (untested)"
    print(f"cpu           : {cpu['name']}, {cpu['generation']}, {cpu['cores']} cores{note}")
    print(f"saved profile : {saved_profile(profiles)}")
    print(f"turbo         : {'enabled' if get_turbo() else 'disabled'}")
    limits = amd_limits(cpu)
    print(f"max frequency : {limits['max_freq'] / 1000:.1f} GHz (hardware {cpu['max_freq'] / 1000:.1f} GHz)")
    if cpu["smu"]:
        table = f"PM table {cpu['smu'].table_version:#x}"
        print(f"power limits  : STAPM {limits['power']:g} W, slow {limits['slow']:g} W, fast {limits['fast']:g} W")
        temp = f"{limits['temp']:g} C" if cpu["tctl"] else "unknown for this table version"
        print(f"throttle at   : {temp} ({table})")
    elif cpu["smu_note"] == "smu_unsupported":
        print("power limits  : not supported on this CPU family (frequency and turbo only)")
    else:
        print(f"power limits  : unavailable ({cpu['smu_error']})")


def status(cpu, profiles):
    if is_amd(cpu):
        amd_status(cpu, profiles)
        return
    note = "" if cpu["tested"] else "  (untested generation)"
    print(f"cpu           : {cpu['name']}, {cpu['generation']}, {cpu['cores']} cores{note}")
    print(f"saved profile : {saved_profile(profiles)}")
    print(f"turbo         : {'enabled' if get_turbo() else 'disabled'}")
    ratios = " / ".join(f"{r / 10:.1f}" for r in get_ratios(cpu))
    print(f"ratios 1-{cpu['cores']}c   : {ratios} GHz{'' if cpu['ratio_writable'] else ' (locked)'}")
    try:
        pl1, pl2 = power_limits(cpu)
        print(f"PL1 / PL2     : {pl1:g} W / {pl2:g} W")
    except (OSError, Unsupported) as err:
        print(f"PL1 / PL2     : unavailable ({err})")
    print(f"throttle at   : {get_tcc(cpu)} C (TjMax {cpu['tjmax']} C){'' if cpu['tcc_writable'] else ' (locked)'}")
    print(f"undervolt     : {get_undervolt()} mV (saved {saved_undervolt()} mV)")
    if undervolt_crash():
        print(f"                reset to 0 after an unclean shutdown at {undervolt_crash()} mV")


def monitor(cpu):
    sample_watts = cpu_power_sampler(cpu)
    print("temp_C watts MHz limits", flush=True)
    while True:
        time.sleep(1)
        limits = ",".join(cpu_active_limits(cpu)) or "-"
        print(f"{cpu_temp(cpu)} {sample_watts():.1f} {max(core_freqs(cpu))} {limits}", flush=True)


# ---------------------------------------------------------------- GUI backend


def handle_request(cpu, factory, raw):
    """Apply and save one JSON request from the GUI; return an error message or None."""
    try:
        request = json.loads(raw)
        if "update_interval" in request:
            if request["update_interval"] not in UPDATE_INTERVALS:
                return "unknown update interval"
            set_update_interval(request["update_interval"])
            return None
        if "undervolt" in request:
            if is_amd(cpu):
                return "undervolting is not available on AMD CPUs"
            if not valid_undervolt(request["undervolt"]):
                return "undervolt out of range"
            set_undervolt(request["undervolt"])
            return None
        if "custom" in request:
            if not valid_profile(request["custom"], cpu, factory):
                return "settings out of range"
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(CUSTOM_FILE, "w") as f:
                json.dump(request["custom"], f)
            name = "custom"
        else:
            name = request["profile"]
        profiles = build_profiles(cpu, factory)
        if name not in profiles:
            return "unknown profile"
        apply(cpu, profiles, name)
        save_profile(name)
    except (ValueError, KeyError, TypeError) as err:
        return f"invalid request: {err}"
    except subprocess.CalledProcessError as err:
        return f"systemctl failed ({err.returncode})"
    except (OSError, Unsupported) as err:
        return str(err)
    except SystemExit as err:
        return str(err.code)
    return None


def serve(cpu):
    """Stream the state as JSON lines each second and apply requests read from stdin."""
    factory = factory_limits(cpu)
    sample_watts = cpu_power_sampler(cpu)
    watts, error = 0.0, None
    while True:
        if select.select([0], [], [], 1)[0]:
            data = os.read(0, 65536)
            if not data:
                return
            for line in data.splitlines():
                error = handle_request(cpu, factory, line)
        else:
            watts = sample_watts()
        profiles = build_profiles(cpu, factory)
        values = current_values(cpu)
        if is_amd(cpu):
            writable = {key: True for key in amd_fields(cpu)}
        else:
            writable = {"ratios": cpu["ratio_writable"], "pl1": values["pl1"] is not None, "tcc": cpu["tcc_writable"]}
        state = {
            "version": __version__,
            "cpu": {k: cpu[k] for k in ("name", "generation", "tested", "cores")},
            "fields": fields(cpu),
            "writable": writable,
            "bounds": bounds(cpu, factory),
            "profile": saved_profile(profiles),
            "profiles": profiles,
            "turbo": get_turbo(),
            "values": values,
            "temp": cpu_temp(cpu),
            "watts": round(watts, 1),
            "freqs": core_freqs(cpu),
            "limits": cpu_active_limits(cpu),
            "notes": [cpu["smu_note"]] if is_amd(cpu) and cpu["smu_note"] else [],
            "undervolt": None if is_amd(cpu) else saved_undervolt(),
            "undervolt_crash": None if is_amd(cpu) else undervolt_crash(),
            "update_interval": saved_update_interval(),
            "error": error,
        }
        try:
            print(json.dumps(state), flush=True)
        except BrokenPipeError:
            return


# ---------------------------------------------------------------- update


def version_tuple(text):
    return tuple(int(part) for part in text.split("."))


def fetch(url):
    request = urllib.request.Request(url, headers={"User-Agent": f"turboctl/{__version__}"})
    return urllib.request.urlopen(request, timeout=60)


def read_install_settings():
    """Return the variables install.sh saved, or None for an install made by a package."""
    try:
        with open(INSTALL_FILE) as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        return None
    return dict(line.split("=", 1) for line in lines if "=" in line)


def saved_update_interval():
    """Return the interval chosen for updates, or None for an install made by a package."""
    if read_install_settings() is None:
        return None
    try:
        interval = read_text(UPDATE_INTERVAL_FILE)
    except OSError:
        return "daily"
    return interval if interval in UPDATE_INTERVALS else "daily"


def set_update_interval(interval):
    """Save the interval and set up the timer for it (also run by install.sh)."""
    if read_install_settings() is None:
        raise Unsupported("automatic updates are only for installs made with install.sh")
    calendar = UPDATE_INTERVALS[interval]
    os.makedirs(STATE_DIR, exist_ok=True)
    write_text(UPDATE_INTERVAL_FILE, interval + "\n")
    if calendar:
        os.makedirs(os.path.dirname(UPDATE_TIMER_DROPIN), exist_ok=True)
        write_text(UPDATE_TIMER_DROPIN, f"[Timer]\nOnCalendar=\nOnCalendar={calendar}\n")
    else:
        remove(UPDATE_TIMER_DROPIN)
    # The preset keeps the choice when the distribution resets services to their presets.
    os.makedirs(os.path.dirname(UPDATE_PRESET), exist_ok=True)
    write_text(UPDATE_PRESET, f"{'enable' if calendar else 'disable'} {UPDATE_TIMER}\n")
    systemctl = ["systemctl", "--quiet"]
    subprocess.run([*systemctl, "daemon-reload"], check=True)
    if calendar:
        subprocess.run([*systemctl, "enable", UPDATE_TIMER], check=True)
        subprocess.run([*systemctl, "restart", UPDATE_TIMER], check=True)
    else:
        subprocess.run([*systemctl, "disable", "--now", UPDATE_TIMER], check=True)


def update():
    """Install the latest release from GitHub if it is newer and signed with the release key."""
    settings = read_install_settings()
    if settings is None:
        sys.exit("turboctl: not installed by install.sh; update it with your package manager")
    if not shutil.which("ssh-keygen"):
        sys.exit("turboctl: ssh-keygen (OpenSSH) is needed to check the release signature")
    try:
        with fetch(LATEST_RELEASE) as response:
            release = json.load(response)
    except (urllib.error.URLError, OSError) as err:
        print(f"turboctl: cannot reach GitHub ({err}); will try again later")
        return
    version = release["tag_name"].lstrip("v")
    if version_tuple(version) <= version_tuple(__version__):
        print(f"turboctl {__version__} is up to date")
        return
    name = f"turboctl-{version}.tar.gz"
    assets = {asset["name"]: asset["browser_download_url"] for asset in release["assets"]}
    if name not in assets or name + ".sig" not in assets:
        sys.exit(f"turboctl: release {version} has no signed archive")
    with tempfile.TemporaryDirectory(prefix="turboctl-update-") as tmp:
        archive = os.path.join(tmp, name)
        for asset in (name, name + ".sig"):
            with fetch(assets[asset]) as source, open(os.path.join(tmp, asset), "wb") as target:
                shutil.copyfileobj(source, target)
        with open(archive, "rb") as data:
            verify = subprocess.run(
                ["ssh-keygen", "-Y", "verify", "-f", ALLOWED_SIGNERS, "-I", SIGNER, "-n", SIGNER,
                 "-s", archive + ".sig"],
                stdin=data, capture_output=True, text=True,
            )
        if verify.returncode != 0:
            sys.exit(f"turboctl: bad signature on release {version}, not installed: {verify.stderr.strip()}")
        with tarfile.open(archive) as tar:
            # The "data" filter refuses links and paths leaving the directory (Python 3.12, backported).
            tar.extractall(tmp, **({"filter": "data"} if hasattr(tarfile, "data_filter") else {}))
        source = os.path.join(tmp, f"turboctl-{version}")
        found = subprocess.run([sys.executable, "turboctl", "--version"], cwd=source, capture_output=True, text=True)
        if found.stdout.strip() != f"turboctl {version}":
            sys.exit(f"turboctl: release {version} contains {found.stdout.strip() or 'no turboctl'}, not installed")
        tests = subprocess.run(
            [sys.executable, "-m", "unittest", "discover", "-s", "tests", "-p", "test_turboctl.py"],
            cwd=source, capture_output=True, text=True, env=dict(os.environ, TURBOCTL_UPDATING="1"),
        )
        if tests.returncode != 0:
            sys.exit(f"turboctl: release {version} fails its tests on this machine, not installed:\n{tests.stderr}")
        subprocess.run(["sh", "install.sh", "--update"], cwd=source, env=dict(os.environ, **settings), check=True)
    print(f"turboctl updated from {__version__} to {version}")


# ---------------------------------------------------------------- uvtest


def uvtest_log(message):
    line = f"{time.strftime('%F %T')} {message}"
    print(line, flush=True)
    # Synced at once: after a freeze, the log shows the step that was running.
    with open(UVTEST_LOG, "a") as f:
        f.write(line + "\n")
        f.flush()
        os.fsync(f.fileno())


def kernel_errors(since):
    log = subprocess.run(
        ["journalctl", "-k", "-q", "--no-pager", "--since", f"@{int(since)}"], capture_output=True, text=True
    ).stdout
    return [line for line in log.splitlines() if KERNEL_ERROR.search(line)]


def stress_phase(stress_args, seconds):
    """Run one stress-ng phase; return a failure description, or None if it passed."""
    since, start = time.time(), time.monotonic()
    try:
        code = subprocess.run(["stress-ng", *stress_args, "--timeout", f"{seconds}s", "--quiet"]).returncode
    except OSError as err:  # a corrupted kernel can refuse to start a program
        return f"could not run stress-ng: {err}"
    elapsed = time.monotonic() - start
    errors = kernel_errors(since)
    if code or errors or elapsed < seconds * 0.95:
        return f"stress-ng exit {code}, {elapsed:.0f}/{seconds} s " + " | ".join(errors)
    return None


def uvtest(start, end):
    """Step the undervolt down until a phase fails; the saved value is restored at the end."""
    if not shutil.which("stress-ng"):
        sys.exit("turboctl: uvtest needs stress-ng")
    os.makedirs(STATE_DIR, exist_ok=True)
    saved, stable = saved_undervolt(), None
    uvtest_log(f"uvtest from {start} to {end} mV, log in {UVTEST_LOG}")
    try:
        for mv in range(start, end - 1, -UVTEST_STEP):
            write_undervolt(mv)
            for phase, stress_args, seconds in UVTEST_PHASES:
                uvtest_log(f"{mv} mV: {phase}, {seconds} s")
                failure = stress_phase(stress_args, seconds)
                if failure:
                    uvtest_log(f"{mv} mV: FAILED ({failure})")
                    return
            stable = mv
            uvtest_log(f"{mv} mV: passed")
    except KeyboardInterrupt:
        uvtest_log("interrupted")
    finally:
        write_undervolt(saved)
        uvtest_log(f"undervolt restored to the saved {saved} mV")
        if stable is None:
            uvtest_log("no step passed")
        else:
            # Margin unless every step up to the end passed.
            advice = stable if stable == end else min(0, stable + UVTEST_MARGIN)
            uvtest_log(f"last stable step {stable} mV, suggested setting {advice} mV")


# ---------------------------------------------------------------- main


def parse_mv(args, count):
    try:
        values = [int(a) for a in args]
    except ValueError:
        sys.exit(__doc__)
    if len(values) > count or not all(valid_undervolt(v) for v in values):
        sys.exit(f"turboctl: values must be between {UNDERVOLT_MIN} and 0 mV")
    return values


def main():
    args = sys.argv[1:]
    command = args[0] if args else ""
    if command in ("--version", "-V"):
        print(f"turboctl {__version__}")
        return
    commands = (
        "status", "monitor", "serve", "watch", "update", "update-interval", "apply", "set", "undervolt", "uvtest",
        "clean-shutdown",
    )
    if command not in commands or len(args) > (3 if command == "uvtest" else 2):
        sys.exit(__doc__)
    if os.geteuid() != 0:
        sys.exit("turboctl: must run as root")
    if command == "clean-shutdown":
        remove(UNDERVOLT_PENDING)
        return
    if command == "update":
        try:
            update()
        except subprocess.CalledProcessError as err:
            sys.exit(f"turboctl: the new install.sh failed ({err.returncode})")
        return
    if command == "update-interval":
        interval = args[1] if len(args) == 2 else saved_update_interval() or "daily"
        if interval not in UPDATE_INTERVALS:
            sys.exit(f"turboctl: WHEN must be one of {', '.join(UPDATE_INTERVALS)}")
        try:
            set_update_interval(interval)
        except Unsupported as err:
            sys.exit(f"turboctl: {err}")
        print(f"updates: {interval}")
        return

    cpu = detect_cpu()
    if is_amd(cpu) and command in ("undervolt", "uvtest"):
        sys.exit("turboctl: undervolting is not available on AMD CPUs")
    try:
        if command == "undervolt":
            values = parse_mv(args[1:], 1)
            if not values:
                sys.exit(__doc__)
            set_undervolt(values[0])
            print(f"undervolt {values[0]} mV applied")
        elif command == "uvtest":
            values = parse_mv(args[1:], 2)
            start, end = (values + [-20, UNDERVOLT_MIN][len(values):])[:2]
            if start < end:
                sys.exit("turboctl: FROM must be above TO")
            uvtest(start, end)
        elif command == "status":
            status(cpu, build_profiles(cpu, factory_limits(cpu)))
        elif command == "monitor":
            monitor(cpu)
        elif command == "serve":
            serve(cpu)
        elif command == "watch":
            watch(cpu)
        else:
            profiles = build_profiles(cpu, factory_limits(cpu))
            name = args[1] if len(args) == 2 else saved_profile(profiles)
            if name not in profiles:
                sys.exit(f"turboctl: profile must be one of {', '.join(profiles)}")
            apply(cpu, profiles, name)
            if command == "set":
                save_profile(name)
            print(f"profile {name} applied")
    except Unsupported as err:
        sys.exit(f"turboctl: {err}")
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
