msgid ""
"Power and temperature limits are not supported on this CPU: turbo and "
"frequency only."
msgstr ""
"Limites de puissance et de température non prises en charge sur ce CPU : "
"turbo et fréquence seulement."

msgid ""
"Power and temperature limits are unavailable: run “sudo turboctl status” for "
"the reason."
msgstr ""
"Limites de puissance et de température indisponibles : lancez « sudo "
"turboctl status » pour en connaître la raison."

